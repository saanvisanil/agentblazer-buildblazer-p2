# Copy this file to .env.local for local development, and add the same
# values in the Vercel dashboard under Settings -> Environment Variables for
# production. .env.local is git-ignored, so real secrets never reach GitHub.

# --- Admin panel (required for /admin to work) ---
# Any strong password of your choosing. Shared by the whole club leadership.
ADMIN_PASSWORD=
# Username for the bootstrap leader account. Defaults to "leader" if unset.
ADMIN_USERNAME=leader

# Random string used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- GitHub content backend (required for /admin to save changes) ---
# A fine-grained GitHub personal access token, scoped ONLY to this repo,
# with "Contents: Read and write" permission and nothing else.
# Create one at https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
# "owner/repo", e.g. AgentBlazer/agentblazer-buildblazer
GITHUB_REPO=AgentBlazer/agentblazer-buildblazer
GITHUB_BRANCH=main

# --- Join form email (optional; the form still works and logs applications
#     to content/applications.json without these) ---
# Free at https://resend.com — verify a sending domain, or use their shared
# onboarding@resend.dev sender for testing.
RESEND_API_KEY=
CONTACT_TO_EMAIL=agentblazer@sjec.ac.in
CONTACT_FROM_EMAIL=AgentBlazer Club <onboarding@resend.dev>

# Public site URL, used for SEO tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://agentblazer.vercel.app
